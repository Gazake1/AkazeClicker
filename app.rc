// Recursos do GNClicker: icone + metadados de versao (VERSIONINFO).
// Os metadados (nome do produto e versao) identificam o binario e sao exigidos
// para assinatura de codigo.
1 ICON "GNClicker.ico"

1 VERSIONINFO
 FILEVERSION 1,0,4,0
 PRODUCTVERSION 1,0,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gazake"
            VALUE "FileDescription", "GNClicker - autoclicker for Minecraft"
            VALUE "FileVersion", "1.0.4.0"
            VALUE "InternalName", "GNClicker"
            VALUE "LegalCopyright", "Copyright (c) 2026 Gazake. MIT License."
            VALUE "OriginalFilename", "GNClicker.exe"
            VALUE "ProductName", "GNClicker"
            VALUE "ProductVersion", "1.0.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
